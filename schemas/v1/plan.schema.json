{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bifrost.invalid/v1/plan.schema.json",
  "title": "Bifrost platform-neutral plan v1",
  "type": "object",
  "required": ["schema", "plan_id", "base_generation", "target_generation", "created_at", "steps", "rollback_required"],
  "properties": {
    "schema": {"const": "bfw.plan/v1"},
    "plan_id": {"$ref": "common.schema.json#/$defs/correlation"},
    "base_generation": {"$ref": "common.schema.json#/$defs/generation"},
    "target_generation": {"$ref": "common.schema.json#/$defs/generation"},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "owner", "action", "idempotency_key", "preconditions", "effect", "verify", "rollback"], "properties": {"id": {"type": "string"}, "owner": {"$ref": "common.schema.json#/$defs/identifier"}, "action": {"type": "string"}, "idempotency_key": {"$ref": "common.schema.json#/$defs/correlation"}, "preconditions": {"type": "array", "items": {"type": "object"}}, "effect": {"type": "object"}, "verify": {"type": "object"}, "rollback": {"type": "object"}}, "additionalProperties": false}},
    "rollback_required": {"const": true}
  },
  "additionalProperties": false
}
