{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bifrost.invalid/v1/switch-plan.schema.json",
  "title": "Bifrost switching plan v1",
  "type": "object",
  "required": ["schema", "plan_id", "base_generation", "bridge_domains", "ports", "verification", "rollback_required"],
  "properties": {
    "schema": {"const": "bfw.switch-plan/v1"},
    "plan_id": {"$ref": "common.schema.json#/$defs/correlation"},
    "base_generation": {"$ref": "common.schema.json#/$defs/generation"},
    "bridge_domains": {"type": "array", "items": {"type": "object", "required": ["id", "vlans", "spanning_tree", "multicast_snooping"], "properties": {"id": {"$ref": "common.schema.json#/$defs/identifier"}, "vlans": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 4094}}, "spanning_tree": {"enum": ["disabled", "stp", "rstp", "mstp"]}, "multicast_snooping": {"type": "boolean"}}, "additionalProperties": false}},
    "ports": {"type": "array", "items": {"type": "object", "required": ["id", "bridge_domain", "mode", "tagged_vlans", "untagged_vlan", "isolation", "lacp_group"], "properties": {"id": {"$ref": "common.schema.json#/$defs/identifier"}, "bridge_domain": {"$ref": "common.schema.json#/$defs/identifier"}, "mode": {"enum": ["access", "trunk"]}, "tagged_vlans": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 4094}}, "untagged_vlan": {"type": ["integer", "null"], "minimum": 1, "maximum": 4094}, "isolation": {"enum": ["none", "protected", "private"]}, "lacp_group": {"type": ["string", "null"]}}, "additionalProperties": false}},
    "verification": {"type": "object", "required": ["vlan_membership", "fdb", "spanning_tree", "lacp", "management_reachability"], "properties": {"vlan_membership": {"const": true}, "fdb": {"const": true}, "spanning_tree": {"const": true}, "lacp": {"const": true}, "management_reachability": {"const": true}}, "additionalProperties": false},
    "rollback_required": {"const": true}
  },
  "additionalProperties": false
}
